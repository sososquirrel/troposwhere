# ── Data (never commit raw / processed data) ─────────────────
data/

# ── Generated figures (reproducible from notebooks) ──────────
paper/figures/

# ── Python bytecode ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Jupyter checkpoints ───────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── OS / editor noise ─────────────────────────────────────────
.DS_Store
*.swp
.vscode/
.idea/

# ── Claude Code memory (local only) ──────────────────────────
.claude/

# ── Model registry (auto-generated, not source) ───────────────
paper/model_comparison/models_registry.yaml

# ── Archived / scratch material (local only) ─────────────────
paper_5clusters/old_stuff/
paper/manuscript.zip

# ── Python package metadata (auto-generated) ─────────────────
*.egg-info/

# ── LaTeX build artifacts (regenerable from .tex) ────────────
*.aux
*.bbl
*.bbl-SAVE-ERROR
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
